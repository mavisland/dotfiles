# Shared interactive shell environment
export EDITOR="micro"
export VISUAL="micro"
export GIT_EDITOR="micro"
export PAGER="less"
export LESS="-FRX"

path_prepend() {
	case ":$PATH:" in
		*":$1:"*) ;;
		*) PATH="$1${PATH:+:$PATH}" ;;
	esac
}

for path_entry in \
	"$HOME/bin" \
	"$HOME/.local/bin" \
	"/opt/homebrew/bin" \
	"/opt/homebrew/sbin" \
	"/usr/local/bin" \
	"/usr/local/sbin"; do
	if [[ -d "$path_entry" ]]; then
		path_prepend "$path_entry"
	fi
done

export PATH

alias c='clear'
alias ..='cd ..'
alias ...='cd ../..'
alias pa='php artisan'
alias pc='composer'
alias pcr='composer require'
alias pcu='composer update'